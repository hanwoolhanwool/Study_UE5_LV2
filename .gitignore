# Unreal Engine generated files and local caches
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/

# Generated plugin files (keep prebuilt plugin binaries)
/Plugins/**/Intermediate/
/Plugins/**/DerivedDataCache/

# IDE settings and generated project files
/.vs/
/.idea/
/.vscode/
/*.sln
/*.suo
/*.sdf
/*.opensdf
/*.VC.db
/*.VC.VC.opendb
/*.code-workspace
/*.xcodeproj/
/*.xcworkspace/

# Local environment files
.env
.env.*
!.env.example
!.env.sample

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Keep Content/, Config/, Source/, Build/, and *.uproject in Git.
# Build/ can contain required icons and packaging configuration.
